storial muestra semanas de muy bajo volumen intercaladas con semanas altas; la irregularidad acumulada puede limitar adaptaciones a largo plazo","Tres sesiones de running en la semana con el largo el domingo deja poco margen de recuperación si la siguiente semana arranca fuerte"],"keyMetrics":[{"label":"Volumen running","value":"38.81 km","trend":"down","status":"green","note":"Ligera baja vs semana anterior, pero dentro de rango saludable"},{"label":"Sesiones running","value":"3 sesiones","trend":"stable","status":"green","note":"Frecuencia consistente con semanas recientes"},{"label":"FC promedio running","value":"139 bpm","trend":"stable","status":"green","note":"Zona aeróbica moderada, adecuada para el volumen realizado"},{"label":"Rodaje largo","value":"23.02 km","trend":"up","status":"green","note":"Mejor sesión larga en semanas recientes"},{"label":"Ritmo largo","value":"5:45 /km","trend":"stable","status":"green","note":"Ritmo conversacional sostenido en 23 km, muy positivo"},{"label":"Ciclismo","value":"33.43 km","trend":"up","status":"green","note":"Complemento cross-training que suma carga sin impacto"},{"label":"Carga semanal","value":"Zona segura","trend":"stable","status":"green","note":"Sin señales de sobreentrenamiento"}],"weekPlan":[{"day":"Lun","type":"Recuperación activa","km":"—","notes":"Movilidad articular 20–25 min o caminata suave. El cuerpo necesita asimilar el largo del domingo."},{"day":"Mar","type":"Rodado suave","km":"8 km","notes":"Ritmo muy cómodo, por encima de 6:00/km. FC por debajo de 135 bpm. Sin presión de velocidad."},{"day":"Mié","type":"Descanso o ciclismo","km":"—","notes":"Si tienes energía, 30–40 min de bici a intensidad baja. Si no, descanso completo."},{"day":"Jue","type":"Tempo corto","km":"10 km","notes":"Incluye 3×8 min a ritmo sostenido (alrededor de 5:20–5:30/km) con recuperación de 3 min entre series."},{"day":"Vie","type":"Descanso","km":"—","notes":"Descanso completo. Hidratación, sueño y alimentación son el entrenamiento de hoy."},{"day":"Sáb","type":"Rodado medio","km":"12 km","notes":"Ritmo aeróbico cómodo, 5:50–6:10/km. Mantén la conversación posible durante toda la sesión."},{"day":"Dom","type":"Descanso o actividad libre","km":"—","notes":"Semana con largo ya hecho el domingo pasado. Descansa o haz actividad recreativa sin presión de km."}],"injuryRisk":{"level":"low","score":28,"topRisk":"Rodillas y caderas","action":"Después de un largo de 23 km, dedica 10 min a estirar cuádriceps, isquiotibiales y banda iliotibial antes de retomar carga el martes."},"funFact":"Tu rodaje del domingo fue tan largo que, si lo hubieras corrido en línea recta desde el centro de Bogotá, habrías llegado casi hasta Chía.","seoulTip":null},"semanaAnalizada":{"inicio":"2026-08-03","fin":"2026-08-09"},"taper":[],"retos":[{"id":1328,"name":"Reto","org":"SWETRO COMMUNITY","type":"distancia","typeIcon":"🏃","goal":[{"activity_type":"running","variable":"distance","condition":"greater_than_or_equal_to","value":18000.0,"unit":"km","value_in_unit":18.0}],"unit":"km","userProgress":0,"startDate":"","endDate":"","daysLeft":0,"totalDays":0,"participants":0,"status":"active","virtual":true,"rank":null,"totalRanked":0,"prizeTiers":[],"description":"","leaderboard":[{"full_name":"Ferney Eduardo M.","gender":"Male","age":33,"country":"COL","is_complete":true,"position":1,"position_by_gender":1,"position_by_gender_and_age_category":1,"position_by_country":1,"total_number_activities":10,"total_distance_in_meters":146640.95922851562,"total_duration_in_seconds":46190,"total_active_kilocalories":7955,"total_elevation_gain_in_meters":1702.0,"total_average_pace_in_minutes_per_kilometer":5.390506618674104,"total_average_heart_rate_in_beats_per_minute":125.2},{"full_name":"Joaquin M.","gender":"Male","age":24,"country":"URY","is_complete":true,"position":2,"position_by_gender":2,"position_by_gender_and_age_category":1,"position_by_country":1,"total_number_activities":11,"total_distance_in_meters":89914.27102886874,"t